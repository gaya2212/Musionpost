# Supabase — required. Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key — bypasses RLS. Server-side only, never expose
# to the client. Used by API routes (onboarding, matching engine, credits).
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — optional. Powers vector similarity in the matching engine
# (lib/matching/embeddings.ts). Without it, matching still works (hard
# filters + genre/verified/recency scoring) but every match score is
# capped around 40% instead of using real content similarity.
OPENAI_API_KEY=

# Resend — optional. Sends the "someone messaged you" email notification
# (lib/email/resend.ts, app/api/messages/notify). Without it, in-app
# messaging works fully — only the email itself doesn't send.
RESEND_API_KEY=
# Defaults to "Musion <notifications@musion.one>" if unset. Must be a
# domain verified in your Resend account or sends will fail.
RESEND_FROM_ADDRESS=
